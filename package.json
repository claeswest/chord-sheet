{
  "name": "clavos-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=chordsheetmaker",
    "build": "cross-env NEXT_DIST_DIR=.next-build npm run build --workspace=chordsheetmaker",
    "start": "npm run start --workspace=chordsheetmaker",
    "lint": "npm run lint --workspace=chordsheetmaker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "cross-env NEXT_DIST_DIR=.next-build npm run e2e --workspace=chordsheetmaker",
    "e2e:watch": "cross-env NEXT_DIST_DIR=.next-build npm run e2e:watch --workspace=chordsheetmaker",
    "e2e:ui": "cross-env NEXT_DIST_DIR=.next-build npm run e2e:ui --workspace=chordsheetmaker",
    "dev:recipes": "npm run dev --workspace=recipemaker",
    "build:recipes": "cross-env NEXT_DIST_DIR=.next-build npm run build --workspace=recipemaker",
    "dev:schedules": "npm run dev --workspace=schedulemaker",
    "build:schedules": "cross-env NEXT_DIST_DIR=.next-build npm run build --workspace=schedulemaker"
  }
}
