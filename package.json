{
  "name": "clavos-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=chordsheetmaker",
    "build": "cross-env NEXT_DIST_DIR=.next-build npm run build --workspace=chordsheetmaker",
    "start": "npm run start --workspace=chordsheetmaker",
    "lint": "npm run lint --workspace=chordsheetmaker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:recipes": "npm run dev --workspace=recipemaker",
    "build:recipes": "cross-env NEXT_DIST_DIR=.next-build npm run build --workspace=recipemaker"
  }
}
