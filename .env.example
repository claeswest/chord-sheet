# Copy to .env and fill in — or run `npx vercel env pull .env` to pull the real
# values from the deployment. Never commit the filled-in file.
# The README explains what each variable does and which are optional.

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# NOTE: this is the PRODUCTION database — see the warning in the README.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# AUTH_SECRET also signs email unsubscribe tokens: changing it invalidates the
# unsubscribe links in already-sent emails. Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Sign in with Apple (optional — button hidden until both are set).
# APPLE_CLIENT_SECRET is the JWT from scripts/generate-apple-secret.mjs (renew <=6mo).
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── AI: Google Gemini (song search/parse, photo OCR, background images) ─────
GEMINI_API_KEY=""

# ── Email via Resend (magic links + admin marketing emails) ─────────────────
# EMAIL_FROM must use a Resend-verified domain in production, e.g.
# "ChordSheetMaker <noreply@chordsheetmaker.ai>". Defaults to onboarding@resend.dev,
# which only delivers to the Resend account owner's own inbox (testing only).
RESEND_API_KEY=""
EMAIL_FROM=""

# ── Admin (comma-separated; also notification + BCC recipients) ─────────────
ADMIN_EMAILS=""

# ── Stripe (payments) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
STRIPE_PRICE_LIFETIME=""

# ── Optional ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""      # GA4 measurement id; analytics no-op when unset
ERROR_WEBHOOK_URL=""      # server-error alerts

# Google Ads conversion label for the "Sign-ups" action. Create the conversion
# action in Ads (Goals → Conversions → New → Website), then Google tag setup
# shows send_to: 'AW-1064389018/AbC-D_efGh'. Put only the part after the slash
# here. Unset = no conversion reported, and Search bids blind.
NEXT_PUBLIC_ADS_SIGNUP_LABEL=""
