# Fixa schemat — copy to .env and fill in. Nothing here is a real value.
#
# In Vercel, a setting takes effect only in a deployment made after it was
# added. And a push does not always make one: Vercel skips this app when a
# commit touches nothing under apps/schedulemaker (an empty commit on 23 Nov
# 2026 changed nothing here, and nor did that morning's ChordSheetMaker
# commits). After adding a setting, press Redeploy in Vercel, or push a change
# to a file in this folder.

# Reading a photographed timetable. The only thing the app needs to run.
# The key's Google project must be on a paid tier — see docs/schedulemaker.md.
GEMINI_API_KEY=

# ── Accounts (optional) ──────────────────────────────────────────────────────
# Without DATABASE_URL and AUTH_SECRET there are no accounts at all, and the app
# is what it was before them: no sign-in, no saving, nothing kept on a server.

# Neon connection string, pooled. On a laptop this is the `dev` branch, never
# production. Production's is set in Vercel and nowhere in this repository.
DATABASE_URL=

# Signs session cookies. Any long random string; a different one in production.
AUTH_SECRET=

# At least one way to sign in. Deployed, accounts stay off until one is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in by an emailed link, through Resend. EMAIL_FROM needs a domain that is
# verified there, e.g. "Fixa schemat <hej@fixaschemat.se>".
RESEND_API_KEY=
EMAIL_FROM=

# Accounts that are on Plus without anyone having paid: a comma-separated list
# of sign-in addresses. How the owner and anyone trying it out get it. See
# src/lib/plans.ts.
PLUS_EMAILS=

# ── Selling Plus (optional) ──────────────────────────────────────────────────
# All three or none. With all three, the Plus page sells Plus; with any one
# missing it asks who wants it instead. See src/lib/stripe.ts.
#
# The key is the Stripe account's, shared with the other two apps. The price is
# this app's own: a recurring price in Stripe, in SEK, with tax behaviour set
# to "inclusive". What it costs is read from there and written nowhere here.
# The webhook secret belongs to an endpoint made for this app alone, at
# <site>/api/stripe/webhook, listening for customer.subscription.created,
# .updated and .deleted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_WEBHOOK_SECRET=

# The site's own address, for the way back from Stripe. Optional: without it
# the address the request came to is used.
AUTH_URL=

# Laptop only, never read in production: an address that answers like Stripe,
# for trying a purchase without Stripe. See src/lib/stripe.ts.
STRIPE_API_BASE=
