# Fixa schemat — copy to .env and fill in. Nothing here is a real value.

# Reading a photographed timetable. The only thing the app needs to run.
# The key's Google project must be on a paid tier — see docs/schedulemaker.md.
GEMINI_API_KEY=

# ── Accounts (optional) ──────────────────────────────────────────────────────
# Without DATABASE_URL and AUTH_SECRET there are no accounts at all, and the app
# is what it was before them: no sign-in, no saving, nothing kept on a server.

# Neon connection string, pooled. On a laptop this is the `dev` branch, never
# production. Production's is set in Vercel and nowhere in this repository.
DATABASE_URL=

# Signs session cookies. Any long random string; a different one in production.
AUTH_SECRET=

# At least one way to sign in. Deployed, accounts stay off until one is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in by an emailed link, through Resend. EMAIL_FROM needs a domain that is
# verified there, e.g. "Fixa schemat <hej@fixaschemat.se>".
RESEND_API_KEY=
EMAIL_FROM=
