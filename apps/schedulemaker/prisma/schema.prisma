// Fixa schemat's database. Its own Neon project, like each product here — see
// packages/core/README.md — and the only one of the three in the EU
// (Frankfurt): what it holds is Swedish children's school timetables.
//
// It exists for one thing: someone who chooses to make an account can keep
// their schedules. The app still works with no account and stores nothing for
// those who don't make one.
//
// ── SHARED BASE ──────────────────────────────────────────────────────────────
// User, Account, Session, VerificationToken and ActivityLog below are copied
// from apps/recipemaker/prisma/schema.prisma and are meant to stay identical to
// it apart from User's relation lines. The plan and Stripe columns are here
// from the start, unused, so that a paid plan later is code and not a change
// to a table with people in it. If you change one of these models, change it
// in all three apps.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  marketingOptOut      Boolean   @default(false)
  lastMarketingEmailAt DateTime?

  // Plan tier: free | monthly | yearly | lifetime
  plan String @default("free")

  // Stripe subscription
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripePriceId            String?
  stripeCurrentPeriodEnd   DateTime?
  stripeSubscriptionStatus String? // trialing | active | past_due | canceled
  stripeCancelAt           DateTime? // set when a cancellation is scheduled

  accounts   Account[]
  sessions   Session[]
  schedules  Schedule[]
  activities ActivityLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ── PRODUCT-SPECIFIC ─────────────────────────────────────────────────────────

/// One saved sheet.
///
/// The whole thing is one JSON value on purpose: it is exactly what the browser
/// keeps in localStorage and what /api/pdf prints (SheetState, in
/// src/lib/sheetState.ts), and nothing here is searched or sorted by what is
/// inside it. `title` and `detail` are copied out only so the list of
/// schedules can be shown without unpacking every one.
///
/// Deleting the user deletes these (onDelete: Cascade). That is the delete
/// button the privacy text promises, done by the database rather than by code
/// that could forget a table.
model Schedule {
  id     String @id @default(cuid())
  userId String

  /// What the list calls it: the banner ("Annas schema"), else the class.
  title  String
  /// Class and school, for telling two schedules with the same name apart.
  detail String?

  /// SheetState: { schedule, glossary, theme, paper, ink, icons, illustration }
  state Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
