# RecipeBookMaker environment. Copy to .env and fill in.
#
# Only DATABASE_URL is needed right now. The rest are listed so it's clear
# what's coming — and because leaving them unset is what makes those features
# no-op rather than crash.
#
# This app has its OWN database, separate from ChordSheetMaker by decision
# (see packages/core/README.md). Point it at RecipeBookMaker's own Neon project,
# and locally at that project's `dev` branch — never at production.

# ── Required now ─────────────────────────────────────────────────────────────
DATABASE_URL=""            # Neon pooled connection string, dev branch

# ── Needed once auth lands ───────────────────────────────────────────────────
# AUTH_SECRET also signs unsubscribe tokens. Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3001"   # 3001, so both apps can run side by side
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Needed once the paid plan lands ──────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# ── Optional ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""          # AI recipe structuring; endpoints 500 clearly without it
RESEND_API_KEY=""          # email sign-in disabled without it
EMAIL_FROM=""              # e.g. "RecipeBookMaker <hello@…>"
ADMIN_EMAILS=""            # comma-separated; gates /admin
NEXT_PUBLIC_GA_ID=""       # analytics no-op without it
ERROR_WEBHOOK_URL=""       # server-error alerts
