// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Marketing emails (admin-triggered nudges): opt-out + anti-double-send marker
  marketingOptOut      Boolean   @default(false)
  lastMarketingEmailAt DateTime?

  // Plan tier: free | monthly | yearly | lifetime
  plan                   String    @default("free")

  // Stripe subscription
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripePriceId            String?
  stripeCurrentPeriodEnd   DateTime?
  stripeSubscriptionStatus String?   // trialing | active | past_due | canceled
  stripeCancelAt           DateTime? // set when a cancellation is scheduled

  accounts   Account[]
  sessions   Session[]
  songs      Song[]
  categories Category[]
  activities ActivityLog[]
  connectedApps ConnectedApp[]
  connectCodes  ConnectCode[]
}

// Generic activity log — one row per notable event (account_created, login,
// sub_started, song_created, ...). meta holds event context (songId, title,
// plan, source). userId is nullable so logs survive user deletion.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id        String   @id @default(cuid())
  userId    String
  title     String
  artist    String?
  key       String?
  capo      Int?
  tempo     Int?
  content   Json     // Structured chord sheet data (sections, lines, chords)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories SongCategory[]

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs    SongCategory[]
  parent   Category?      @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[]     @relation("Subcategories")

  @@index([userId])
}

model SongCategory {
  songId     String
  categoryId String
  order      Int    @default(0)

  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([songId, categoryId])
}

model Share {
  id        String   @id @default(cuid())
  title     String
  artist    String   @default("")
  content   Json     // { lines, style } — style includes backgroundImage
  createdAt DateTime @default(now())
}

// ── Connecting an AI app (ChatGPT, Claude) to an account ─────────────────────
// The sign-in an app goes through before it may use /api/mcp as one person:
// lib/connectedApps.ts, /oauth/authorize, /api/oauth/*. Three new tables and no
// new column on any old one, so the rest of the app runs the same whether or
// not they exist yet.

// One app connected to one account. The keys the app holds are stored only as
// hashes: a copy of this table opens nothing.
model ConnectedApp {
  id             String    @id @default(cuid())
  userId         String
  clientId       String    @db.Text // the app's id: an AppRegistration id, or the web address it identifies itself by
  clientName     String    // what the app called itself when the person said yes
  accessHash     String    @unique // the short-lived key sent with each request
  accessExpires  DateTime
  refreshHash    String    @unique // the key that fetches a new pair; replaced each time it is used
  refreshExpires DateTime
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A "yes" on the Allow page, kept for the couple of minutes until the app
// swaps it for keys. Used once: redeeming it deletes the row.
model ConnectCode {
  codeHash      String   @id
  userId        String
  clientId      String   @db.Text
  clientName    String
  redirectUri   String   @db.Text
  codeChallenge String   // proves the app collecting the keys is the one that asked (PKCE)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// An app that introduced itself through /api/oauth/register, the older of the
// two ways. Newer apps identify themselves by a web address and have no row.
model AppRegistration {
  id           String   @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
